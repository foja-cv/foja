---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Editor de CV sobre Typst: formularios, vista previa en vivo y exportación a PDF, Word, LaTeX y más. Todo en tu navegador." } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.svg`} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="h-full bg-white text-neutral-900 dark:bg-neutral-900 dark:text-neutral-100">
    <slot />
  </body>
</html>
